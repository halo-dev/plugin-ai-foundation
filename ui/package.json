{
  "type": "module",
  "private": true,
  "scripts": {
    "build": "pnpm -C packages/sdk run build && pnpm type-check && pnpm build-only",
    "build-only": "vite build",
    "dev": "vite build --watch --mode=development",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path ../.gitignore",
    "lint:eslint": "eslint . --fix",
    "lint": "run-s lint:*",
    "prettier": "prettier . --write --ignore-path ../.gitignore --ignore-path ./.prettierignore",
    "test:unit": "vitest run",
    "type-check": "vue-tsc --build"
  },
  "prettier": {
    "printWidth": 100,
    "semi": false,
    "singleQuote": true,
    "tabWidth": 2,
    "plugins": [
      "prettier-plugin-organize-imports"
    ]
  },
  "dependencies": {
    "@formkit/core": "2.1.0",
    "@formkit/vue": "2.1.0",
    "@halo-dev/ai-foundation-sdk": "workspace:*",
    "@halo-dev/api-client": "^2.25.1",
    "@halo-dev/components": "^2.25.1",
    "@halo-dev/ui-shared": "^2.25.1",
    "@tanstack/vue-query": "^4.44.0",
    "@vueuse/core": "^14.3.0",
    "@vueuse/integrations": "^14.3.0",
    "@vueuse/router": "^14.3.0",
    "axios": "^1.16.1",
    "dompurify": "^3.4.3",
    "fuse.js": "^7.3.0",
    "markdown-it": "^14.1.1",
    "pinia": "^3.0.4",
    "reka-ui": "^2.10.1",
    "vue": "^3.5.34",
    "vue-router": "5.0.6"
  },
  "devDependencies": {
    "@formkit/themes": "2.1.0",
    "@halo-dev/ui-plugin-bundler-kit": "https://pkg.pr.new/@halo-dev/ui-plugin-bundler-kit@815292f",
    "@iconify-json/mingcute": "^1.2.7",
    "@iconify-json/ri": "^1.2.10",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.12.4",
    "@unocss/eslint-config": "^66.6.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.10",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.39.4",
    "eslint-plugin-oxlint": "^0.16.12",
    "eslint-plugin-vue": "~10.0.1",
    "happy-dom": "^20.9.0",
    "npm-run-all2": "^9.0.2",
    "oxlint": "^0.16.12",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "~5.8.3",
    "unocss": "^66.6.8",
    "unplugin-icons": "^23.0.1",
    "vite": "^8.2.1",
    "vitest": "^4.1.6",
    "vue-tsc": "^3.2.9"
  },
  "packageManager": "pnpm@10.33.4"
}
